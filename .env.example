# AWS Deployment Environment Variables
# Copy this file to .env and fill in your actual values

# Required API Keys for AWS Lambda
MERAKI_API_KEY=your_meraki_dashboard_api_key_here
FINGERBANK_API_KEY=your_fingerbank_api_key_here
WEBHOOK_SECRET=your_webhook_shared_secret_here

# AWS Lambda Configuration (required for deployment)
LOG_LEVEL=INFO
AUTO_APPLY_POLICIES=false
ENABLE_CONFLICT_RESOLUTION=true
ENABLE_USAGE_ANALYSIS=true
BATCH_SIZE=100

# AWS Configuration (optional - will use AWS CLI defaults if not set)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Local Development Configuration (not needed for AWS Lambda)
# DATABASE_URL=postgresql://classifier:changeme@postgres:5432/meraki_classifier
# POSTGRES_PASSWORD=changeme
# WEBHOOK_PORT=5000
# REDIS_URL=redis://redis:6379/0
# FLASK_SECRET_KEY=your_flask_secret_key_here
# SSL_CERT_PATH=/app/ssl/cert.pem
# SSL_KEY_PATH=/app/ssl/key.pem
# WEBHOOK_TIMEOUT=30
# MAX_WEBHOOK_RETRIES=3
# CLASSIFICATION_CACHE_TTL=3600
# ENABLE_METRICS=true
# METRICS_PORT=9090

# Network Configuration (optional)
# MERAKI_NETWORK_IDS=L_123456789,L_987654321
# DEFAULT_NETWORK_ID=L_123456789